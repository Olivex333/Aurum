# Skopiuj do pliku .env i uzupelnij. Plik .env nie trafia do repozytorium.
# Sekret do podpisywania tokenow JWT, min. 32 losowe znaki, np.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PGHOST=localhost
PGPORT=5432
PGDATABASE=aurum
PGUSER=postgres
PGPASSWORD=

PORT=3000
# Opcjonalnie: dozwolone domeny panelu (po przecinku). Puste = brak ograniczen (tylko do developmentu).
CORS_ORIGINS=
